+bool ConnectedSemantics::isCandidateLabel(int semantic_id) const {
+  const auto& label_space = hydra::GlobalInfo::instance().getLabelSpaceConfig();
+  return label_space.isObject(semantic_id) ||
+         (config.promote_dynamic_labels && label_space.isDynamic(semantic_id));
+}
+
+void ConnectedSemantics::promoteDynamicSemanticClusters(FrameData& data) const {
+  const auto& label_space = hydra::GlobalInfo::instance().getLabelSpaceConfig();
+
+  // Prefer the full semantic component over a partial geometric motion cluster for a
+  // known dynamic class. This avoids duplicate tracks while retaining unknown dynamics.
+  data.dynamic_clusters.erase(
+      std::remove_if(
+          data.dynamic_clusters.begin(),
+          data.dynamic_clusters.end(),
+          [&](const MeasurementCluster& cluster) {
+            if (cluster.pixels.empty()) {
+              return false;
+            }
+            size_t dynamic_pixels = 0;
+            for (const Pixel& pixel : cluster.pixels) {
+              const int semantic_id =
+                  data.input.label_image.at<InputData::LabelType>(pixel.v, pixel.u);
+              dynamic_pixels += label_space.isDynamic(semantic_id) ? 1 : 0;
+            }
+            const float overlap =
+                static_cast<float>(dynamic_pixels) / static_cast<float>(cluster.pixels.size());
+            return overlap >= config.dynamic_semantic_overlap_threshold;
+          }),
+      data.dynamic_clusters.end());
+
+  for (const MeasurementCluster& cluster : data.semantic_clusters) {
+    if (!cluster.semantics || !label_space.isDynamic(cluster.semantics->category_id)) {
+      continue;
+    }
+    data.dynamic_clusters.push_back(cluster);
+  }
+
+  data.dynamic_image.setTo(0);
+  int id = 1;
+  for (MeasurementCluster& cluster : data.dynamic_clusters) {
+    cluster.id = id;
+    for (const Pixel& pixel : cluster.pixels) {
+      data.dynamic_image.at<FrameData::DynamicImageType>(pixel.v, pixel.u) = id;
+    }
+    if (id == 255) {
+      LOG(WARNING) << "Maximum number (255) of dynamic clusters reached.";
+      break;
+    }
+    ++id;
+  }
+}
