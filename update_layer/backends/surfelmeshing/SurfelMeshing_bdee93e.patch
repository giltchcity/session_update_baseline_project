+u32 CUDASurfelReconstruction::Retire(cudaStream_t stream, const std::vector<u32>& indices, const std::vector<u32>& creation_stamps) {
+  u32 retired = RetireSurfelsCUDA(stream, indices, creation_stamps, surfel_count_, surfels_.get());
+  merge_count_ += retired;  // surfel_count() counts live surfels
+  return retired;
+}
