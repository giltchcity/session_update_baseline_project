diff --git a/applications/surfel_meshing/src/surfel_meshing/cuda_surfel_reconstruction_kernels.cc b/applications/surfel_meshing/src/surfel_meshing/cuda_surfel_reconstruction_kernels.cc
index 97cb1f4..d7bb374 100644
--- a/applications/surfel_meshing/src/surfel_meshing/cuda_surfel_reconstruction_kernels.cc
+++ b/applications/surfel_meshing/src/surfel_meshing/cuda_surfel_reconstruction_kernels.cc
@@ -510,4 +510,35 @@ void MergeSurfelsCUDA(
   *merge_count += num_merges;
 }
 
+
+u32 RetireSurfelsCUDA(
+    cudaStream_t stream,
+    const std::vector<u32>& indices,
+    const std::vector<u32>& creation_stamps,
+    u32 surfel_count,
+    CUDABuffer<float>* surfels) {
+  CHECK_EQ(indices.size(), creation_stamps.size());
+  const u32 count = indices.size();
+  if (count == 0) {
+    return 0;
+  }
+  u32* d_indices;
+  u32* d_creation;
+  u32* d_retired;
+  CUDA_CHECKED_CALL(cudaMalloc(&d_indices, count * sizeof(u32)));
+  CUDA_CHECKED_CALL(cudaMalloc(&d_creation, count * sizeof(u32)));
+  CUDA_CHECKED_CALL(cudaMalloc(&d_retired, sizeof(u32)));
+  CUDA_CHECKED_CALL(cudaMemcpyAsync(d_indices, indices.data(), count * sizeof(u32), cudaMemcpyHostToDevice, stream));
+  CUDA_CHECKED_CALL(cudaMemcpyAsync(d_creation, creation_stamps.data(), count * sizeof(u32), cudaMemcpyHostToDevice, stream));
+  CUDA_CHECKED_CALL(cudaMemsetAsync(d_retired, 0, sizeof(u32), stream));
+  CallRetireSurfelsCUDAKernel(stream, count, d_indices, d_creation, surfel_count, surfels->ToCUDA(), d_retired);
+  u32 retired = 0;
+  CUDA_CHECKED_CALL(cudaMemcpyAsync(&retired, d_retired, sizeof(u32), cudaMemcpyDeviceToHost, stream));
+  CUDA_CHECKED_CALL(cudaStreamSynchronize(stream));
+  cudaFree(d_indices);
+  cudaFree(d_creation);
+  cudaFree(d_retired);
+  return retired;
+}
+
 }
