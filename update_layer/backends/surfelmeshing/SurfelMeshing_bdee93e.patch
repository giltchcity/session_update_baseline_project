+__global__ void RetireSurfelsCUDAKernel(
+    u32 count,
+    const u32* indices,
+    const u32* creation_stamps,
+    u32 surfel_count,
+    CUDABuffer_<float> surfels,
+    u32* retired) {
+  unsigned int k = blockIdx.x * blockDim.x + threadIdx.x;
+  if (k >= count) {
+    return;
+  }
+  const u32 surfel_index = indices[k];
+  if (surfel_index >= surfel_count ||
+      *reinterpret_cast<u32*>(&surfels(kSurfelCreationStamp, surfel_index)) != creation_stamps[k] ||
+      surfels(kSurfelRadiusSquared, surfel_index) < 0) {
+    return;
+  }
+  // As MergeSurfel deletes a surfel.
+  *reinterpret_cast<u32*>(&surfels(kSurfelLastUpdateStamp, surfel_index)) = 0;
+  surfels(kSurfelRadiusSquared, surfel_index) = -1;
+  *reinterpret_cast<u8*>(&reinterpret_cast<uchar4*>(&surfels(kSurfelColor, surfel_index))->w) = 1;  // Set neighbor detach request flag
+  atomicAdd(retired, 1u);
+}
+
+void CallRetireSurfelsCUDAKernel(
+    cudaStream_t stream,
+    u32 count,
+    const u32* indices,
+    const u32* creation_stamps,
+    u32 surfel_count,
+    CUDABuffer_<float> surfels,
+    u32* retired) {
+  if (count == 0) {
+    return;
+  }
+  constexpr int kBlockSize = 256;
+  RetireSurfelsCUDAKernel<<<(count + kBlockSize - 1) / kBlockSize, kBlockSize, 0, stream>>>(
+      count, indices, creation_stamps, surfel_count, surfels, retired);
+  #ifdef CUDA_SEQUENTIAL_CHECKS
+    cudaDeviceSynchronize();
+  #endif
+  CHECK_CUDA_NO_ERROR();
+}
+
 }
